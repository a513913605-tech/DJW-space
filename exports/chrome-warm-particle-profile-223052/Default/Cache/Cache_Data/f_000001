          }

          if (state === "scatter") {
            const driftBand = seededNoise(index, 30);
            return {
              x: width * (0.06 + seededNoise(index, 4) * 0.88),
              y: height * (0.08 + seededNoise(index, 5) * 0.84),
              z,
              size: driftBand > 0.96 ? 4 + random * 8 : 0.45 + random * (driftBand > 0.76 ? 3.8 : 1.8),
