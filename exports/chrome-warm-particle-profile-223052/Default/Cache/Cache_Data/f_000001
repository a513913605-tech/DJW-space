              x: centerX + Math.cos(angle) * radius,
              y: centerY + Math.sin(angle) * radius,
              z,
              size: isFacet ? 2.8 + random * 6.2 : 0.7 + random * 2.2,
              alpha: 0.18 + random * 0.36,
              layer: isFacet ? "facet" : "structure"
            };
          }

          const radius = stageRadius * (0.035 + Math.sqrt(random) * 0.24);
          const flatten = 0.78 + seededNoise(index, 31) * 0.28;
          return {
            x: centerX + Math.cos(angle) * radius * flatten,
            y: centerY + Math.sin(angle) * radius * 0.82,
            z,
            size: isBokeh ? 4 + random * 8 : isFacet ? 2.2 + random * 5.8 : 0.42 + random * 1.55,
            alpha: isBokeh ? 0.04 + random * 0.08 : 0.12 + random * 0.36,
            layer: isBokeh ? "bokeh" : isFacet ? "facet" : "structure"
