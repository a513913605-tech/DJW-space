                tx: targetValues.tx,
                ty: targetValues.ty,
                ts: targetValues.ts,
                ta: targetValues.ta,
                duration: state === "scatter" ? 1.4 : 1.05,
                ease: state === "proton" ? "power4.inOut" : "power3.inOut"
