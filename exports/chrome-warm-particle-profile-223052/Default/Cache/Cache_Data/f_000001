            particle.ta = lerp(from.alpha, to.alpha, segment.progress);
            particle.layer = segment.progress > 0.55 ? to.layer : from.layer;

            if (immediate) {
              particle.x = particle.tx + (seededNoise(index, 8) - 0.5) * width * 0.18;
              particle.y = particle.ty + (seededNoise(index, 9) - 0.5) * height * 0.18;
              particle.z = particle.tz;
              particle.size = particle.ts;
              particle.alpha = particle.ta;
            }
          });
