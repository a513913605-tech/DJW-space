        const particles = [];
        const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, vx: 0, vy: 0, power: 0 };
        const stateOrder = [
          ["hero", "planet"],
          ["about", "shell"],
          ["ability", "atom"],
          ["selected", "scatter"],
          ["contact", "proton"]
