            const r3 = base * (0.18 + seededNoise(i, 74) * 0.62);
            const x1 = Math.cos(a1) * r1;
            const y1 = Math.sin(a1) * r1 * 0.82;
            const x2 = Math.cos(a2) * r2;
            const y2 = Math.sin(a2) * r2 * 0.82;
            const x3 = Math.cos((a1 + a2) * 0.5 + 0.9) * r3;
            const y3 = Math.sin((a1 + a2) * 0.5 + 0.9) * r3 * 0.82;
            const alpha = (0.06 + seededNoise(i, 75) * 0.16) * intensity;
            const gradient = ctx.createLinearGradient(x1, y1, x2, y2);
            gradient.addColorStop(0, `rgba(255,255,255,${alpha + 0.12})`);
            gradient.addColorStop(0.54, `rgba(214,208,196,${alpha})`);
            gradient.addColorStop(1, `rgba(150,158,158,${alpha * 0.48})`);
            ctx.fillStyle = gradient;
            ctx.strokeStyle = `rgba(255,255,255,${alpha + 0.08})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.lineTo(x3, y3);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
          }

          ctx.strokeStyle = `rgba(255,255,255,${0.32 * intensity})`;
          ctx.lineWidth = 1.1;
          for (let i = 0; i < 3; i += 1) {
            ctx.save();
            ctx.rotate(i * 0.82 + breathe * (0.04 + i * 0.01));
            ctx.beginPath();
            ctx.ellipse(0, 0, base * (1.28 + i * 0.18), base * (0.32 + i * 0.06), 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
          }
          ctx.restore();
        }

        function drawParticleLinks() {
          const cx = width * 0.5;
          const cy = height * 0.47;
          const linkRadius = activeState === "scatter" ? Math.min(width, height) * 0.42 : Math.min(width, height) * 0.28;
          ctx.save();
          ctx.globalCompositeOperation = "source-over";
          ctx.strokeStyle = activeState === "atom" ? "rgba(255,255,255,0.22)" : "rgba(170,176,176,0.12)";
          ctx.lineWidth = 0.7;
          for (let i = 0; i < particles.length; i += 34) {
            const particle = particles[i];
            const dist = Math.hypot(particle.x - cx, particle.y - cy);
            if (dist > linkRadius || particle.layer === "dust") continue;
            const next = particles[(i + 89) % particles.length];
            if (!next || Math.hypot(next.x - cx, next.y - cy) > linkRadius) continue;
            ctx.beginPath();
            ctx.moveTo(particle.x, particle.y);
            ctx.lineTo(next.x, next.y);
            ctx.stroke();
          }
          ctx.restore();
        }

        function drawFacet(x, y, size, rotation, alpha, highlight) {
          const sides = 3;
          ctx.save();
          ctx.translate(x, y);
          ctx.rotate(rotation);
          ctx.globalCompositeOperation = "source-over";
          const gradient = ctx.createLinearGradient(-size, -size, size, size);
          gradient.addColorStop(0, `rgba(255,255,255,${0.8 * alpha + highlight * 0.22})`);
          gradient.addColorStop(0.48, `rgba(218,214,204,${0.44 * alpha})`);
          gradient.addColorStop(1, `rgba(124,132,132,${0.16 * alpha})`);
          ctx.fillStyle = gradient;
          ctx.strokeStyle = `rgba(255,255,255,${0.58 * alpha})`;
          ctx.lineWidth = 0.55;
          ctx.beginPath();
          for (let i = 0; i < sides; i += 1) {
            const a = -Math.PI / 2 + (Math.PI * 2 * i) / sides;
            const px = Math.cos(a) * size;
            const py = Math.sin(a) * size;
            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          if (highlight > 0.12) {
            ctx.globalCompositeOperation = "lighter";
            ctx.strokeStyle = `rgba(255,255,255,${Math.min(0.42, highlight * 0.32)})`;
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.moveTo(-size * 0.32, -size * 0.22);
            ctx.lineTo(size * 0.42, -size * 0.08);
            ctx.stroke();
          }
          ctx.restore();
        }

        function render() {
          breathe += 0.011;
          pointer.x += (pointer.tx - pointer.x) * 0.18;
          pointer.y += (pointer.ty - pointer.y) * 0.18;
          pointer.power *= 0.94;
          burst *= 0.94;
          scrollEnergy *= 0.9;
          applyScrollMorph();

          ctx.clearRect(0, 0, width, height);
          drawEnergyBloom();
          drawCrystalCore();
          drawOrbitalGuides();
          drawParticleLinks();
          ctx.save();
          ctx.globalCompositeOperation = "source-over";

          particles.forEach((particle) => {
            const pointerDx = particle.x - pointer.x;
            const pointerDy = particle.y - pointer.y;
            const pointerDist = Math.hypot(pointerDx, pointerDy);
            const fieldRadius = 210 + pointer.power * 0.42;
            const pointerForce = pointerDist < fieldRadius ? Math.pow((fieldRadius - pointerDist) / fieldRadius, 1.4) : 0;
            const orbitForce = pointerForce * (activeState === "atom" ? 44 : 32);
            const normalX = pointerDx / Math.max(pointerDist, 1);
            const normalY = pointerDy / Math.max(pointerDist, 1);
            const tangentX = -normalY * particle.spin;
            const tangentY = normalX * particle.spin;
            const driftAmp = particle.layer === "bokeh" ? 24 : particle.layer === "dust" ? 16 : 7;
            const driftX = Math.cos(breathe * (0.7 + particle.speed * 6) + particle.drift) * driftAmp;
            const driftY = Math.sin(breathe * (0.62 + particle.speed * 5) + particle.drift) * driftAmp * 0.76;
            const zoomPulse = 1 + scrollEnergy * 4.2 + Math.sin(scrollSegment.progress * Math.PI) * 0.34;
            const cx = width * 0.5;
            const cy = height * 0.47;
            const projectedTx = cx + (particle.tx - cx) * zoomPulse;
            const projectedTy = cy + (particle.ty - cy) * zoomPulse;
            const repelX = pointerForce ? normalX * orbitForce + tangentX * orbitForce * 0.74 : 0;
            const repelY = pointerForce ? normalY * orbitForce + tangentY * orbitForce * 0.74 : 0;
            const targetX = projectedTx + driftX + repelX;
            const targetY = projectedTy + driftY + repelY;

            particle.x += (targetX - particle.x) * particle.speed;
            particle.y += (targetY - particle.y) * particle.speed;
            particle.z += (particle.tz - particle.z) * particle.speed;
            particle.size += (particle.ts - particle.size) * 0.06;
            particle.alpha += (particle.ta - particle.alpha) * 0.05;
            particle.rotation += particle.rotationSpeed + pointerForce * 0.03 * particle.spin;

            const twinkle = 0.78 + Math.sin(breathe * 2.2 + particle.drift) * 0.22;
            const perspective = clamp(1 + particle.z / 1100, 0.55, 1.85);
            const drawSize = particle.size * perspective * (1 + scrollEnergy * 1.6);
            const glowSize = particle.layer === "bokeh" ? drawSize * 2.2 : particle.layer === "facet" ? drawSize * 1.4 : drawSize * 1.9;
            const alpha = Math.min(0.86, particle.alpha * twinkle + pointerForce * 0.24);
            if (particle.layer === "bokeh") {
              const glow = ctx.createRadialGradient(particle.x, particle.y, 0, particle.x, particle.y, glowSize);
              glow.addColorStop(0, `rgba(255,255,255,${0.34 * alpha})`);
              glow.addColorStop(0.48, `rgba(215,220,220,${0.12 * alpha})`);
              glow.addColorStop(1, "rgba(215,220,220,0)");
              ctx.fillStyle = glow;
              ctx.beginPath();
              ctx.arc(particle.x, particle.y, glowSize, 0, Math.PI * 2);
              ctx.fill();
            } else if (particle.layer === "facet") {
              drawFacet(particle.x, particle.y, drawSize, particle.rotation, alpha, pointerForce);
              return;
            }

            ctx.beginPath();
            ctx.fillStyle = particle.layer === "dust" || particle.layer === "bokeh"
              ? `rgba(255, 255, 255, ${alpha})`
              : `rgba(182, 188, 188, ${alpha})`;
            ctx.arc(particle.x, particle.y, drawSize, 0, Math.PI * 2);
            ctx.fill();
          });

          if (pointer.x > -1000 && pointer.power > 0.8) {
            ctx.strokeStyle = `rgba(165, 172, 172, ${Math.min(0.24, pointer.power / 1400)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(pointer.x, pointer.y, 72 + pointer.power * 0.05, 0, Math.PI * 2);
            ctx.stroke();
          }

          ctx.restore();

          if (!reduceMotion && !hasGSAP) requestAnimationFrame(render);
        }

        window.addEventListener("scroll", requestScrollMorph, { passive: true });

        window.addEventListener("resize", resize);

        resize();
        initParticles();
        applyScrollMorph(true);
        if (hasGSAP && !reduceMotion) {
          gsap.ticker.add(render);
        } else {
          render();
        }
      }

      function initGSAPMotion() {
        if (!hasGSAP || reduceMotion) return;

        gsap.set([".content--hero h1", ".content--hero .identity", ".hero-kicker", ".scroll-hint"], {
          autoAlpha: 0,
          y: 22
        });

        const heroTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
        heroTimeline
          .to(".hero-kicker", { autoAlpha: 1, y: 0, duration: 0.8 })
          .to(".content--hero h1", { autoAlpha: 1, y: 0, duration: 1.05 }, "-=0.42")
          .to(".content--hero .identity", { autoAlpha: 1, y: 0, duration: 0.86 }, "-=0.5")
          .to(".scroll-hint", { autoAlpha: 1, y: 0, duration: 0.7 }, "-=0.26");

        gsap.to(".shape--planet", {
          scale: 1.035,
          y: -8,
          duration: 4.8,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut"
        });

        if (window.ScrollTrigger) {
          ScrollTrigger.batch(".section-copy, .intro-visual, .ability, .works-slider, .contact-list, .archive-link, .mini-mark", {
            start: "top 78%",
            once: true,
            onEnter: (elements) => {
              gsap.fromTo(elements,
                { autoAlpha: 0, y: 34, scale: 0.985 },
                { autoAlpha: 1, y: 0, scale: 1, duration: 0.92, stagger: 0.08, ease: "power3.out" }
              );
            }
          });

          gsap.to(".shape--opening", {
            scale: 1.16,
            autoAlpha: 0.78,
            scrollTrigger: {
              trigger: "#about",
              start: "top 82%",
              end: "bottom 20%",
              scrub: 1
            }
          });

          gsap.to(".shape--core", {
            rotation: 18,
            scale: 1.08,
            scrollTrigger: {
              trigger: "#selected",
              start: "top 82%",
              end: "bottom 30%",
              scrub: 1
            }
          });
        }
      }

      initParticleField();
      initGSAPMotion();

      const modal = document.querySelector("#workModal");
      const modalPanel = document.querySelector(".work-modal__panel");
      const modalTitle = document.querySelector("#modalTitle");
      const modalDesc = document.querySelector("#modalDesc");
      const modalTags = document.querySelector("#modalTags");
      const modalImage = document.querySelector("#modalImage");
      const closeButton = document.querySelector(".modal-close");
      const avatarButton = document.querySelector(".intro-visual");
      const avatarThumb = document.querySelector(".intro-visual img");
      const avatarModal = document.querySelector("#avatarModal");
      const avatarPanel = document.querySelector(".avatar-modal__panel");
      const avatarClose = document.querySelector(".avatar-close");
      let activeCard = null;

      const spring = {
        duration: 620,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        fill: "both"
      };

      const closeSpring = {
        duration: 420,
        easing: "cubic-bezier(0.32, 0, 0.67, 0)",
        fill: "both"
      };

      function getTransformFromCard(card) {
        const cardRect = card.getBoundingClientRect();
        const panelRect = modalPanel.getBoundingClientRect();
        const cardCenterX = cardRect.left + cardRect.width / 2;
        const cardCenterY = cardRect.top + cardRect.height / 2;
        const panelCenterX = panelRect.left + panelRect.width / 2;
        const panelCenterY = panelRect.top + panelRect.height / 2;
        const scaleX = Math.max(cardRect.width / panelRect.width, 0.08);
        const scaleY = Math.max(cardRect.height / panelRect.height, 0.08);

        return {
          x: cardCenterX - panelCenterX,
          y: cardCenterY - panelCenterY,
          scaleX,
          scaleY
        };
      }

      function animateOpen(card) {
        if (hasGSAP && !reduceMotion) {
          gsap.killTweensOf(modalPanel);
          const from = getTransformFromCard(card);
          gsap.fromTo(modalPanel,
            {
              autoAlpha: 0.72,
              borderRadius: 24,
              x: from.x,
              y: from.y,
              scaleX: from.scaleX,
              scaleY: from.scaleY
            },
            {
              autoAlpha: 1,
              borderRadius: 34,
              x: 0,
              y: 0,
              scaleX: 1,
              scaleY: 1,
              duration: 0.64,
              ease: "back.out(1.08)"
            }
          );
          return;
        }

        modalPanel.getAnimations().forEach((animation) => animation.cancel());
        const from = getTransformFromCard(card);
        modalPanel.animate(
          [
            {
              opacity: 0.72,
              borderRadius: "24px",
              transform: `translate3d(${from.x}px, ${from.y}px, 0) scale(${from.scaleX}, ${from.scaleY})`
            },
            {
              opacity: 1,
              borderRadius: "38px",
              transform: "translate3d(0, -6px, 0) scale(1.018)"
            },
            {
              opacity: 1,
              borderRadius: "34px",
              transform: "translate3d(0, 0, 0) scale(1)"
            }
          ],
          spring
        );
      }

      function animateClose() {
        if (!activeCard) return Promise.resolve();
        if (hasGSAP && !reduceMotion) {
          gsap.killTweensOf(modalPanel);
          const to = getTransformFromCard(activeCard);
          return new Promise((resolve) => {
            gsap.to(modalPanel, {
              autoAlpha: 0,
              borderRadius: 24,
              x: to.x,
              y: to.y,
              scaleX: to.scaleX,
              scaleY: to.scaleY,
              duration: 0.34,
              ease: "power3.in",
              onComplete: resolve
            });
          });
        }

        modalPanel.getAnimations().forEach((animation) => animation.cancel());
        const to = getTransformFromCard(activeCard);
        return modalPanel.animate(
          [
            {
              opacity: 1,
              borderRadius: "34px",
              transform: "translate3d(0, 0, 0) scale(1)"
            },
            {
              opacity: 0,
              borderRadius: "24px",
              transform: `translate3d(${to.x}px, ${to.y}px, 0) scale(${to.scaleX}, ${to.scaleY})`
            }
          ],
          closeSpring
        ).finished.catch(() => {});
      }

      document.querySelectorAll(".card").forEach((card) => {
        card.addEventListener("click", () => {
          activeCard = card;
          modalTitle.textContent = card.dataset.title;
          modalDesc.textContent = card.dataset.desc;
          modalImage.src = card.dataset.image;
          modalImage.alt = card.dataset.title;
          modalTags.innerHTML = card.dataset.tags
            .split("/")
            .map((tag) => `<span>${tag.trim()}</span>`)
            .join("");
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
          requestAnimationFrame(() => animateOpen(card));
        });
      });

      const closeModal = async () => {
        await animateClose();
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
      };

      closeButton.addEventListener("click", closeModal);
      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.classList.contains("is-open")) closeModal();
      });

      avatarThumb.addEventListener("load", () => {
        avatarButton.classList.add("has-image");
      });

      avatarThumb.addEventListener("error", () => {
        avatarButton.classList.remove("has-image");
      });

      function getTransformFromElement(source, target) {
        const sourceRect = source.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        const sourceCenterX = sourceRect.left + sourceRect.width / 2;
        const sourceCenterY = sourceRect.top + sourceRect.height / 2;
        const targetCenterX = targetRect.left + targetRect.width / 2;
        const targetCenterY = targetRect.top + targetRect.height / 2;

        return {
          x: sourceCenterX - targetCenterX,
          y: sourceCenterY - targetCenterY,
          scaleX: Math.max(sourceRect.width / targetRect.width, 0.08),
          scaleY: Math.max(sourceRect.height / targetRect.height, 0.08)
        };
      }

      function animateAvatarOpen() {
        if (hasGSAP && !reduceMotion) {
          gsap.killTweensOf(avatarPanel);
          const from = getTransformFromElement(avatarButton, avatarPanel);
          gsap.fromTo(avatarPanel,
            {
              autoAlpha: 0.72,
              borderRadius: 24,
              x: from.x,
              y: from.y,
              scaleX: from.scaleX,
              scaleY: from.scaleY
            },
            {
              autoAlpha: 1,
              borderRadius: 34,
              x: 0,
              y: 0,
              scaleX: 1,
              scaleY: 1,
              duration: 0.64,
              ease: "back.out(1.08)"
            }
          );
          return;
        }

        avatarPanel.getAnimations().forEach((animation) => animation.cancel());
        const from = getTransformFromElement(avatarButton, avatarPanel);
        avatarPanel.animate(
          [
            {
              opacity: 0.72,
              borderRadius: "24px",
              transform: `translate3d(${from.x}px, ${from.y}px, 0) scale(${from.scaleX}, ${from.scaleY})`
            },
            {
              opacity: 1,
              borderRadius: "38px",
              transform: "translate3d(0, -6px, 0) scale(1.018)"
            },
            {
              opacity: 1,
              borderRadius: "34px",
              transform: "translate3d(0, 0, 0) scale(1)"
            }
          ],
          spring
        );
      }

      function animateAvatarClose() {
        if (hasGSAP && !reduceMotion) {
          gsap.killTweensOf(avatarPanel);
          const to = getTransformFromElement(avatarButton, avatarPanel);
          return new Promise((resolve) => {
            gsap.to(avatarPanel, {
              autoAlpha: 0,
              borderRadius: 24,
              x: to.x,
              y: to.y,
              scaleX: to.scaleX,
              scaleY: to.scaleY,
              duration: 0.34,
              ease: "power3.in",
              onComplete: resolve
            });
          });
        }

        avatarPanel.getAnimations().forEach((animation) => animation.cancel());
        const to = getTransformFromElement(avatarButton, avatarPanel);
        return avatarPanel.animate(
          [
            {
              opacity: 1,
              borderRadius: "34px",
              transform: "translate3d(0, 0, 0) scale(1)"
            },
            {
              opacity: 0,
              borderRadius: "24px",
              transform: `translate3d(${to.x}px, ${to.y}px, 0) scale(${to.scaleX}, ${to.scaleY})`
            }
          ],
          closeSpring
        ).finished.catch(() => {});
      }

      avatarButton.addEventListener("click", () => {
        avatarModal.classList.add("is-open");
        avatarModal.setAttribute("aria-hidden", "false");
        requestAnimationFrame(animateAvatarOpen);
      });

      const closeAvatarModal = async () => {
        await animateAvatarClose();
        avatarModal.classList.remove("is-open");
        avatarModal.setAttribute("aria-hidden", "true");
      };

      avatarClose.addEventListener("click", closeAvatarModal);
      avatarModal.addEventListener("click", (event) => {
        if (event.target === avatarModal) closeAvatarModal();
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && avatarModal.classList.contains("is-open")) closeAvatarModal();
      });

      const abilityItems = Array.from(document.querySelectorAll(".ability__item"));

      abilityItems.forEach((item) => {
        item.addEventListener("click", (event) => {
          event.stopPropagation();
          const isActive = item.classList.contains("is-active");
          abilityItems.forEach((ability) => ability.classList.remove("is-active"));
          if (!isActive) item.classList.add("is-active");
        });
      });

      document.addEventListener("click", (event) => {
        if (!event.target.closest(".ability")) {
          abilityItems.forEach((item) => item.classList.remove("is-active"));
        }
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          abilityItems.forEach((item) => item.classList.remove("is-active"));
        }
      });

      const slider = document.querySelector("#worksSlider");
      const sliderStage = document.querySelector(".works-slider");
      const prevButton = document.querySelector(".slider-btn--prev");
      const nextButton = document.querySelector(".slider-btn--next");
      const sliderDots = document.querySelector(".slider-dots");
      const sliderCards = Array.from(slider.querySelectorAll(".card"));
      let currentSlide = 0;
      let sliderTimer = null;

      function getSlideStep() {
        const firstCard = sliderCards[0];
        if (!firstCard) return 0;
        const gap = parseFloat(getComputedStyle(slider).columnGap || "0");
        return firstCard.getBoundingClientRect().width + gap;
      }

      function getSliderOffset() {
        const cardWidth = sliderCards[0]?.getBoundingClientRect().width || 0;
        const stageWidth = sliderStage.getBoundingClientRect().width;
        return (stageWidth - cardWidth) / 2;
      }

      function updateSliderState() {
        sliderCards.forEach((card, index) => {
          card.classList.toggle("is-current", index === currentSlide);
        });

        sliderDots.querySelectorAll(".slider-dot").forEach((dot, index) => {
          dot.classList.toggle("is-active", index === currentSlide);
        });
      }

      function goToSlide(index, shouldRestart = true) {
        if (!sliderCards.length) return;
        currentSlide = (index + sliderCards.length) % sliderCards.length;
        const x = getSliderOffset() - getSlideStep() * currentSlide;
        if (hasGSAP && !reduceMotion) {
          gsap.to(slider, {
            x,
            duration: 0.86,
            ease: "back.out(0.82)"
          });
          gsap.fromTo(sliderCards[currentSlide],
            { scale: 0.982 },
            { scale: 1, duration: 0.58, ease: "back.out(1.12)" }
          );
        } else {
          slider.style.transform = `translate3d(${x}px, 0, 0)`;
        }
        updateSliderState();
        if (shouldRestart) restartSlider();
      }

      function nextSlide(shouldRestart = true) {
        goToSlide(currentSlide + 1, shouldRestart);
      }

      function restartSlider() {
        window.clearInterval(sliderTimer);
        sliderTimer = window.setInterval(() => nextSlide(false), 4200);
      }

      sliderCards.forEach((_, index) => {
        const dot = document.createElement("button");
        dot.className = "slider-dot";
        dot.type = "button";
        dot.setAttribute("aria-label", `查看第 ${index + 1} 个精选作品`);
        dot.addEventListener("click", () => goToSlide(index));
        sliderDots.appendChild(dot);
      });

      prevButton.addEventListener("click", () => goToSlide(currentSlide - 1));
      nextButton.addEventListener("click", () => goToSlide(currentSlide + 1));
      slider.addEventListener("mouseenter", () => window.clearInterval(sliderTimer));
      slider.addEventListener("mouseleave", restartSlider);
      slider.addEventListener("focusin", () => window.clearInterval(sliderTimer));
      slider.addEventListener("focusout", restartSlider);
      window.addEventListener("resize", () => goToSlide(currentSlide, false));
      goToSlide(0, false);
      restartSlider();

    </script>
  </body>
  </html>
