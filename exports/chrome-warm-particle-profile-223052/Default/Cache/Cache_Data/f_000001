        updateViewSize();

        for (let i = 0; i < count; i += 1) {
          const targets = buildTargets(i);
          const start = targets.planet;
          particles.push({
            x: start.x + (seededNoise(i, 20) - 0.5) * viewW * 0.08,
            y: start.y + (seededNoise(i, 21) - 0.5) * viewH * 0.08,
            z: start.z + (seededNoise(i, 22) - 0.5) * 180,
            tx: start.x,
            ty: start.y,
            tz: start.z,
            size: start.size,
            alpha: start.alpha,
