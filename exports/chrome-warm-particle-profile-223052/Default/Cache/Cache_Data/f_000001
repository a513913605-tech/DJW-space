        }

        function assignTargets(state, immediate = false) {
          activeState = state;
          particles.forEach((particle, index) => {
            const target = targetFor(index, state);
            const targetValues = {
              tx: target.x,
              ty: target.y,
              ts: target.size,
              ta: target.alpha,
              layer: target.layer
            };

            if (hasGSAP && !immediate && !reduceMotion) {
