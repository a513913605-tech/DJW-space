            }

            if (immediate) {
              particle.x = target.x + (seededNoise(index, 8) - 0.5) * width * 0.32;
              particle.y = target.y + (seededNoise(index, 9) - 0.5) * height * 0.32;
              particle.size = target.size;
              particle.alpha = target.alpha;
            }
          });
        }

        function buildTargetSet(index) {
          return stateOrder.reduce((set, [, state]) => {
            set[state] = targetFor(index, state);
            return set;
          }, {});
        }

        function rebuildTargets() {
          particles.forEach((particle, index) => {
            particle.targets = buildTargetSet(index);
          });
        }

        function initParticles() {
          particles.length = 0;
          for (let i = 0; i < particleCount; i += 1) {
            const target = targetFor(i, "planet");
            particles.push({
              x: width * seededNoise(i, 10),
              y: height * seededNoise(i, 11),
              tx: target.x,
              ty: target.y,
              z: target.z,
              tz: target.z,
              size: target.size,
              ts: target.size,
              alpha: target.alpha,
              ta: target.alpha,
              layer: target.layer,
              drift: seededNoise(i, 12) * Math.PI * 2,
              rotation: seededNoise(i, 15) * Math.PI * 2,
              rotationSpeed: (seededNoise(i, 16) - 0.5) * 0.022,
              spin: seededNoise(i, 14) > 0.5 ? 1 : -1,
              speed: 0.034 + seededNoise(i, 13) * 0.058,
              targets: buildTargetSet(i)
            });
          }
        }

        function clamp(value, min, max) {
          return Math.min(max, Math.max(min, value));
        }

        function smoothstep(value) {
