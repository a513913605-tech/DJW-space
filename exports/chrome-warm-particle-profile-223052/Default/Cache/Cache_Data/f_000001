        function drawEnergyBloom() {
          const cx = width * 0.5;
          const cy = height * 0.47;
          const radiusMap = {
            planet: 148,
            shell: 260,
            atom: 118,
            scatter: 360,
            proton: 58
          };
          const r = Math.min(width, height, radiusMap[activeState] || 150);
          const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, r * 1.7);
          gradient.addColorStop(0, activeState === "proton" ? "rgba(255,255,255,0.9)" : "rgba(255,255,255,0.58)");
          gradient.addColorStop(0.22, "rgba(210,214,214,0.2)");
          gradient.addColorStop(0.58, "rgba(180,186,186,0.06)");
