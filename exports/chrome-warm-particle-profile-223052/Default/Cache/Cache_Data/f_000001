            const orbitTilt = orbitIndex % 2 ? 0.38 : 0.68;
            const nucleusChance = index % 5 === 0;
            const radius = nucleusChance ? Math.pow(random, 1.8) * 50 : baseRadius + ring * 22;
            return {
              x: centerX + Math.cos(angle + orbitIndex * 0.7) * radius,
              y: centerY + Math.sin(angle + orbitIndex * 0.7) * radius * orbitTilt,
              z,
              size: nucleusChance ? 2.6 + random * 6.8 : isFacet ? 2.2 + random * 5.2 : 0.55 + random * 1.7,
              alpha: nucleusChance ? 0.28 + random * 0.36 : 0.16 + random * 0.28,
              layer: nucleusChance || isFacet ? "facet" : "structure"
