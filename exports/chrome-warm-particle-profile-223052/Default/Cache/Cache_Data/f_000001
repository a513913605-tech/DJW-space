          scrollTicking = true;
          requestAnimationFrame(() => {
            updateScrollSegment();
            applyScrollMorph();
            scrollTicking = false;
          });
        }

        function drawOrbitalGuides() {
          const cx = width * 0.5;
          const cy = height * 0.47;
          const radius = Math.min(width, height);
          const glow = activeState === "scatter" ? 0.06 : 0.13;
