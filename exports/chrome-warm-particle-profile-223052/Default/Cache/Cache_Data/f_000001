          ctx.fill();
          ctx.restore();
        }

        function drawCrystalCore() {
          if (activeState !== "planet" && activeState !== "shell" && activeState !== "atom") return;
          const cx = width * 0.5;
          const cy = activeState === "planet" ? height * 0.43 : height * 0.47;
          const base = Math.min(width, height) * (activeState === "planet" ? 0.115 : activeState === "shell" ? 0.16 : 0.085);
          const intensity = activeState === "shell" ? 0.7 : activeState === "atom" ? 0.58 : 1;

          ctx.save();
          ctx.globalCompositeOperation = "source-over";
          const coreGlow = ctx.createRadialGradient(cx, cy, 0, cx, cy, base * 2.2);
          coreGlow.addColorStop(0, `rgba(255,255,255,${0.72 * intensity})`);
          coreGlow.addColorStop(0.3, `rgba(232,224,206,${0.24 * intensity})`);
