<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>戴金旺个人作品集</title>
    <style>
      :root {
        --bg: #f7f5ef;
        --bg-soft: #f0ece3;
        --panel: rgba(255, 255, 255, 0.78);
        --text: #171717;
        --muted: #6f6a61;
        --line: rgba(23, 23, 23, 0.08);
        --accent: #f2a43a;
        --accent-soft: rgba(242, 164, 58, 0.18);
        --surface: rgba(255, 255, 255, 0.58);
        --surface-strong: rgba(255, 255, 255, 0.84);
        --radius-lg: 24px;
        --radius-md: 18px;
        --page-max: 1180px;
        --copy-left: clamp(78px, 9vw, 168px);
        --section-y: clamp(78px, 9vh, 112px);
        --section-bottom: clamp(58px, 7vh, 88px);
        --font-body: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Source Han Sans SC", "Segoe UI", sans-serif;
        --font-display: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Source Han Sans SC", "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      @keyframes fadeRise {
        from {
          opacity: 0;
          transform: translate3d(0, 18px, 0);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }

      @keyframes softFloat {
        0%,
        100% {
          transform: translate3d(0, 0, 0);
        }
        50% {
          transform: translate3d(0, -6px, 0);
        }
      }

      @keyframes glowPulse {
        0%,
        100% {
          opacity: 0.72;
        }
        50% {
          opacity: 1;
        }
      }

      @keyframes backdropBreathe {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      body {
        position: relative;
        isolation: isolate;
        margin: 0;
        font-family: var(--font-body);
        color: var(--text);
        letter-spacing: 0.01em;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 50% -8%, rgba(255, 255, 255, 0.96), transparent 30%),
          radial-gradient(circle at 50% 14%, rgba(210, 214, 214, 0.2), transparent 36%),
          linear-gradient(180deg, #fbfaf7 0%, #f2f1ec 54%, #ebe9e2 100%);
        background-size: auto;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.88), transparent 34%),
          radial-gradient(circle at 50% 50%, rgba(249, 243, 229, 0.36), transparent 58%),
          linear-gradient(90deg, rgba(31, 29, 25, 0.055), transparent 24%, transparent 76%, rgba(31, 29, 25, 0.055));
        mix-blend-mode: multiply;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse at 50% 38%, rgba(255, 255, 255, 0.68), transparent 30%),
          radial-gradient(ellipse at center, transparent 46%, rgba(34, 31, 26, 0.035) 78%, rgba(34, 31, 26, 0.07) 100%);
      }

      .particle-canvas {
        position: fixed;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 1;
        mix-blend-mode: normal;
      }

      .has-gsap .shape {
        animation: none;
      }

      .has-gsap .center-stage .shape {
        opacity: 0.08;
        filter: blur(1px);
      }

      .has-gsap .works__grid {
        transition: none;
      }

      @keyframes orbitSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      @keyframes counterSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(-360deg); }
      }

      @keyframes planetDriftA {
        0%, 100% { translate: 0 0; }
        50% { translate: 10px -14px; }
      }

      @keyframes planetDriftB {
        0%, 100% { translate: 0 0; }
        50% { translate: -12px 9px; }
      }

      @keyframes planetDriftC {
        0%, 100% { translate: 0 0; }
        50% { translate: 8px 12px; }
      }

      .frame {
        position: fixed;
        inset: 20px;
        border: 1px solid rgba(23, 23, 23, 0.08);
        pointer-events: none;
        z-index: 20;
      }

      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 60;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 24px 34px;
        animation: fadeRise 700ms ease-out both;
        pointer-events: none;
      }

      .site-signature {
        position: fixed;
        top: 34px;
        left: 34px;
        z-index: 61;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 14px;
        border: 1px solid rgba(23, 23, 23, 0.07);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.58);
        backdrop-filter: blur(14px);
        font-size: 13px;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: rgba(23, 23, 23, 0.68);
        box-shadow: 0 12px 28px rgba(23, 23, 23, 0.035);
        animation: fadeRise 700ms ease-out both;
      }

      .site-signature::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 16px rgba(242, 164, 58, 0.42);
      }

      .nav__links {
        backdrop-filter: blur(16px);
        background: rgba(255, 255, 255, 0.68);
        border: 1px solid rgba(23, 23, 23, 0.08);
        border-radius: 999px;
        box-shadow:
          0 14px 34px rgba(23, 23, 23, 0.045),
          inset 0 1px 0 rgba(255,255,255,0.8);
        transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease, background-color 220ms ease;
        pointer-events: auto;
      }

      .nav__brand {
        display: none;
        font-size: 13px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(23, 23, 23, 0.48);
        pointer-events: none;
      }

      .nav__links {
        display: flex;
        gap: 6px;
        padding: 7px;
        font-size: 13px;
        color: var(--muted);
      }

      .nav__links span:last-child {
        color: var(--text);
      }

      .nav__links a {
        color: inherit;
        text-decoration: none;
        padding: 10px 15px;
        border-radius: 999px;
        transition: color 220ms ease, background-color 220ms ease, text-shadow 220ms ease, transform 220ms ease;
      }

      .nav__links .is-active {
        color: var(--text);
        background: rgba(255, 255, 255, 0.74);
        box-shadow: inset 0 0 0 1px rgba(23, 23, 23, 0.04);
      }

      .nav__links:hover {
        transform: translateY(-2px);
        border-color: rgba(242, 164, 58, 0.18);
        box-shadow:
          0 10px 22px rgba(23, 23, 23, 0.035),
          0 0 24px rgba(242, 164, 58, 0.1);
      }

      .nav__links a:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.62);
        text-shadow: 0 0 18px rgba(242, 164, 58, 0.2);
        transform: translateY(-1px);
      }

      .nav__links a::after {
        content: "";
        display: block;
        width: 0;
        height: 1px;
        margin-top: 4px;
        background: rgba(23, 23, 23, 0.72);
        transition: width 220ms ease;
      }

      .nav__links a:hover::after,
      .nav__links a.is-active::after {
        width: 0;
      }

      main {
        position: relative;
        z-index: 1;
      }

      .section {
        position: relative;
        min-height: 90svh;
        padding: var(--section-y) 7vw var(--section-bottom);
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        overflow: hidden;
      }

      #hero {
        min-height: 100svh;
      }

      #about {
        min-height: 88svh;
        grid-template-columns: minmax(0, 720px) minmax(148px, 210px);
        justify-content: start;
        gap: clamp(72px, 9vw, 168px);
      }

      #ability,
      #selected {
        align-items: start;
        padding-top: clamp(92px, 11vh, 132px);
      }

      #ability .section-heading,
      #selected .works__header {
        margin-left: 0;
      }

      .section + .section {
        border-top: 0;
      }

      .label { display: none; }

      .center-stage {
        display: none;
      }

      .shape {
        position: relative;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background:
          radial-gradient(circle at 35% 35%, rgba(255,255,255,0.92), rgba(255,255,255,0.12) 32%, rgba(242,164,58,0.18) 46%, rgba(23,23,23,0.05) 60%, transparent 70%),
          radial-gradient(circle at center, rgba(242,164,58,0.16), transparent 58%);
        box-shadow:
          0 0 0 1px rgba(23,23,23,0.05),
          inset 0 0 60px rgba(255,255,255,0.66),
          0 16px 42px rgba(242,164,58,0.08);
        animation: softFloat 7s ease-in-out infinite;
      }

      .shape::before,
      .shape::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        border: 1px dashed rgba(23, 23, 23, 0.08);
      }

      .shape::before {
        inset: -12%;
      }

      .shape::after {
        inset: 14%;
        border-style: solid;
        border-color: rgba(242, 164, 58, 0.18);
      }

      .shape--planet {
        width: min(48vw, 480px);
        aspect-ratio: 1;
        transition: transform 280ms ease, box-shadow 280ms ease, filter 280ms ease;
      }

      .shape--opening {
        width: min(52vw, 520px);
        aspect-ratio: 1;
        clip-path: polygon(0 0, 100% 0, 100% 44%, 78% 52%, 100% 100%, 0 100%, 0 52%, 24% 46%);
      }

      .shape--human {
        width: min(32vw, 280px);
        aspect-ratio: 0.62;
        border-radius: 44% 44% 40% 40% / 18% 18% 50% 50%;
        filter: blur(0.2px);
      }

      .shape--core {
        width: min(32vw, 320px);
        aspect-ratio: 1;
      }

      .shape--core::before {
        inset: -24%;
      }

      .shape--core::after {
        inset: 24%;
      }

      .shape--contact {
        width: min(28vw, 260px);
        opacity: 0.34;
        filter: blur(0.4px);
      }

      .content {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 22px;
        max-width: 520px;
      }

      .section-copy {
        width: min(100%, 760px);
        justify-self: start;
        margin-left: var(--copy-left);
      }

      .content--hero {
        margin-top: 12vh;
        justify-self: center;
        text-align: center;
        max-width: min(82vw, 960px);
        animation: fadeRise 900ms ease-out 120ms both;
        transition: transform 260ms ease, opacity 260ms ease;
      }

      .hero-kicker {
        margin-bottom: 28px;
        font-size: 10px;
        letter-spacing: 0.72em;
        text-indent: 0.72em;
        text-transform: uppercase;
        color: rgba(23, 23, 23, 0.38);
      }

      .side-label {
        position: absolute;
        z-index: 2;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(23, 23, 23, 0.42);
      }

      .side-label--left {
        left: 34px;
        top: 42%;
      }

      .side-label--right {
        right: 34px;
        top: 24%;
      }

      .eyebrow {
        width: fit-content;
        padding: 8px 12px;
        border: 1px solid rgba(23, 23, 23, 0.06);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.54);
        backdrop-filter: blur(12px);
        font-size: 12px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(23, 23, 23, 0.4);
      }

      .section-heading {
        display: grid;
        gap: 16px;
        max-width: 760px;
        justify-self: start;
      }

      h1,
      h2,
      p {
        margin: 0;
      }

      h1 {
        font-family: var(--font-display);
        font-size: clamp(82px, 12.8vw, 202px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        font-weight: 720;
      }

      h2 {
        font-family: var(--font-display);
        font-size: clamp(34px, 4vw, 64px);
        line-height: 1.05;
        letter-spacing: -0.025em;
        font-weight: 720;
      }

      .identity {
        margin-top: 10px;
        font-size: clamp(18px, 2.2vw, 34px);
        letter-spacing: 0.02em;
        font-weight: 720;
        color: rgba(23, 23, 23, 0.82);
      }

      .intro {
        justify-self: start;
        margin: 0;
        padding: 12px 0;
        max-width: 720px;
        animation: fadeRise 850ms ease-out 180ms both;
      }

      .intro p {
        max-width: 680px;
        font-size: clamp(15px, 1.22vw, 18px);
        line-height: 1.92;
        letter-spacing: 0.02em;
      }

      .intro-visual {
        position: relative;
        z-index: 2;
        justify-self: start;
        align-self: center;
        width: clamp(148px, 14vw, 210px);
        aspect-ratio: 2 / 3;
        margin-right: 0;
        padding: 0;
        overflow: hidden;
        border-radius: 32px;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(23, 23, 23, 0.06);
        box-shadow:
          0 28px 64px rgba(23, 23, 23, 0.055),
          inset 0 0 40px rgba(255, 255, 255, 0.72);
        cursor: pointer;
        pointer-events: auto;
        transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
      }

      .intro-visual:hover {
        transform: translateY(-7px) scale(1.018);
        border-color: rgba(242, 164, 58, 0.22);
        box-shadow:
          0 24px 48px rgba(23, 23, 23, 0.055),
          0 0 34px rgba(242, 164, 58, 0.12);
      }

      .intro-visual img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: 50% 45%;
        opacity: 0;
        transition: opacity 260ms ease, transform 420ms ease;
      }

      .intro-visual.has-image img {
        opacity: 1;
      }

      .intro-visual:hover img {
        transform: scale(1.035);
      }

      .intro-visual__fallback {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        color: rgba(23, 23, 23, 0.38);
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .intro-visual.has-image .intro-visual__fallback {
        display: none;
      }

      .avatar-modal {
        position: fixed;
        inset: 0;
        z-index: 31;
        display: grid;
        place-items: center;
        padding: 28px;
        background:
          radial-gradient(circle at 50% 42%, rgba(242, 164, 58, 0.14), transparent 30%),
          rgba(247, 245, 239, 0.78);
        backdrop-filter: blur(18px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 360ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .avatar-modal.is-open {
        opacity: 1;
        pointer-events: auto;
      }

      .avatar-modal__panel {
        position: relative;
        width: min(86vw, 560px);
        max-height: 86vh;
        border-radius: 34px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid rgba(23, 23, 23, 0.08);
        box-shadow:
          0 34px 80px rgba(23, 23, 23, 0.13),
          0 0 60px rgba(242, 164, 58, 0.14);
        transform-origin: center;
        will-change: transform, opacity, border-radius;
      }

      .avatar-modal__panel img {
        width: 100%;
        max-height: 86vh;
        display: block;
        object-fit: contain;
      }

      .avatar-close {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 2;
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.78);
        color: rgba(23, 23, 23, 0.62);
        cursor: pointer;
        backdrop-filter: blur(12px);
        transition: transform 220ms ease, background-color 220ms ease, color 220ms ease;
      }

      .avatar-close:hover {
        transform: scale(1.08) rotate(8deg);
        background: rgba(242, 164, 58, 0.18);
        color: var(--text);
      }

      .muted {
        color: var(--muted);
      }

      .ability {
        justify-self: center;
        width: min(70vw, 820px);
        aspect-ratio: 1;
        border-radius: 50%;
        border: 1px solid rgba(23, 23, 23, 0.06);
        background:
          radial-gradient(circle at center, rgba(242,164,58,0.09), transparent 24%),
          radial-gradient(circle at center, rgba(23,23,23,0.03) 1px, transparent 1px);
        background-size: auto, 18px 18px;
        display: grid;
        place-items: center;
        position: relative;
        box-shadow: inset 0 0 90px rgba(255, 255, 255, 0.42);
      }

      .ability-wrap {
        position: relative;
        z-index: 2;
        display: grid;
        gap: clamp(38px, 5vh, 58px);
        justify-self: stretch;
        width: 100%;
      }

      .ability-wrap .muted {
        max-width: 760px;
        line-height: 1.86;
        letter-spacing: 0.02em;
      }

      .ability__ring {
        position: absolute;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 1px dashed rgba(23, 23, 23, 0.08);
      }

      .ability__core {
        width: 18%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(242,164,58,0.34), rgba(242,164,58,0.08) 70%, transparent 72%);
      }

      .ability__orbit {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        animation: orbitSpin 120s linear infinite;
      }

      .ability__item {
        position: absolute;
        display: block;
        padding: 0;
        place-items: center;
        border-radius: 50%;
        background:
          radial-gradient(circle at 35% 28%, rgba(255,255,255,0.92), rgba(255,255,255,0.68) 58%, rgba(242,164,58,0.07)),
          rgba(255,255,255,0.74);
        border: 1px solid rgba(23,23,23,0.08);
        font-size: 18px;
        line-height: 1.25;
        letter-spacing: 0.04em;
        text-align: center;
        box-shadow:
          0 14px 30px rgba(23, 23, 23, 0.035),
          inset 0 0 36px rgba(242, 164, 58, 0.04);
        cursor: pointer;
        pointer-events: auto;
        appearance: none;
        transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease, background-color 260ms ease;
        color: var(--text);
        font: inherit;
      }

      .ability__item:hover,
      .ability__item.is-active,
      .ability__item:focus-visible {
        outline: none;
        border-color: rgba(242, 164, 58, 0.28);
        box-shadow:
          0 18px 40px rgba(23, 23, 23, 0.045),
          0 0 38px rgba(242, 164, 58, 0.14),
          inset 0 0 42px rgba(242, 164, 58, 0.08);
      }

      .ability__label {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: grid;
        place-items: center;
        padding: 24px;
        border-radius: inherit;
        font-weight: 680;
      }

      .ability__skills {
        position: absolute;
        inset: 50% auto auto 50%;
        z-index: 4;
        pointer-events: none;
      }

      .ability__skill {
        position: absolute;
        left: 0;
        top: 0;
        width: max-content;
        max-width: 180px;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(23, 23, 23, 0.07);
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(12px);
        color: rgba(23, 23, 23, 0.64);
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: 0.03em;
        white-space: nowrap;
        box-shadow:
          0 10px 22px rgba(23, 23, 23, 0.035),
          0 0 22px rgba(242, 164, 58, 0.08);
        opacity: 0;
        transform: translate(-50%, -50%) translate(0, 0) scale(0.82);
        transition:
          opacity 240ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .ability__item:hover .ability__skill,
      .ability__item.is-active .ability__skill,
      .ability__item:focus-visible .ability__skill {
        opacity: 1;
        transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(1);
      }

      .a1 {
        width: 232px;
        height: 232px;
        top: 45%;
        left: 0%;
        font-size: 25px;
        animation: counterSpin 120s linear infinite, planetDriftA 15s ease-in-out infinite;
      }

      .a2 {
        width: 168px;
        height: 168px;
        top: 6%;
        left: 48%;
        font-size: 18px;
        animation: counterSpin 120s linear infinite, planetDriftB 18s ease-in-out infinite;
      }

      .a3 {
        width: 208px;
        height: 208px;
        top: 34%;
        right: 2%;
        font-size: 24px;
        animation: counterSpin 120s linear infinite, planetDriftC 17s ease-in-out infinite;
      }

      .a4 {
        width: 138px;
        height: 138px;
        bottom: 13%;
        right: 11%;
        font-size: 17px;
        animation: counterSpin 120s linear infinite, planetDriftB 20s ease-in-out infinite;
      }

      .a5 {
        width: 184px;
        height: 184px;
        bottom: 5%;
        left: 24%;
        font-size: 22px;
        animation: counterSpin 120s linear infinite, planetDriftA 19s ease-in-out infinite;
      }

      .works {
        position: relative;
        z-index: 2;
        display: grid;
        gap: clamp(34px, 5vh, 54px);
        width: 100%;
        justify-self: stretch;
      }

      .works__header {
        display: grid;
        gap: 16px;
        max-width: 760px;
      }

      .works__header .muted,
      .contact .muted {
        line-height: 1.86;
        letter-spacing: 0.02em;
        max-width: 820px;
      }

      .works__grid {
        display: flex;
        gap: 30px;
        padding: 12px 0;
        overflow: visible;
        scroll-snap-type: none;
        transform: translate3d(0, 0, 0);
        transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
