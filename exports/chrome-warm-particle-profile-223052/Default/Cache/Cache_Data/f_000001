        function targetFor(index, state) {
          const centerX = width * 0.5;
          const centerY = state === "planet" ? height * 0.43 : height * 0.47;
          const angle = seededNoise(index, 1) * Math.PI * 2;
          const random = seededNoise(index, 2);
          const ring = seededNoise(index, 3);
          const roleNoise = seededNoise(index, 20);
          const isDust = roleNoise < 0.34;
          const isBokeh = roleNoise > 0.992;
          const isFacet = roleNoise > 0.68;
          const depth = seededNoise(index, 21);
          const stageRadius = Math.min(width, height);
          const z = (depth - 0.5) * 760;

          if (isDust && state !== "proton" && state !== "planet" && state !== "atom") {
            const sideBias = seededNoise(index, 22);
            const x = width * (sideBias < 0.5 ? seededNoise(index, 23) * 0.42 : 0.58 + seededNoise(index, 24) * 0.42);
            const y = height * (0.04 + seededNoise(index, 25) * 0.92);
            return {
              x,
              y,
              z,
              size: isBokeh ? 5 + depth * 8 : 0.45 + depth * 1.65,
              alpha: isBokeh ? 0.04 + depth * 0.08 : 0.08 + depth * 0.22,
              layer: isBokeh ? "bokeh" : "dust"
