                from: current.state,
                to: next.state,
                progress: smoothstep((scrollY - current.top) / distance)
              };
            }
          }

          if (scrollY < anchors[0].top) {
            return { from: anchors[0].state, to: anchors[0].state, progress: 0 };
          }

          const last = anchors[anchors.length - 1];
          return { from: last.state, to: last.state, progress: 1 };
