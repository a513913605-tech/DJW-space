    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hasGSAP = Boolean(window.gsap);

      if (hasGSAP) {
        document.documentElement.classList.add("has-gsap");

        gsap.defaults({
          ease: "power3.out",
          duration: 0.86,
          overwrite: "auto"
        });

        if (window.ScrollTrigger) {
          gsap.registerPlugin(ScrollTrigger);
        }
      }

      function initParticleField() {
        const canvas = document.querySelector("#particleCanvas");
        if (!canvas || !window.THREE) {
          initCanvasParticleField();
          return;
        }

        const THREE = window.THREE;
        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance"
        });
        renderer.setClearColor(0xffffff, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.65));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 1, 2600);
        camera.position.set(0, 0, 920);

        const stateOrder = [
          ["hero", "planet"],
          ["about", "shell"],
          ["ability", "atom"],
          ["selected", "scatter"],
          ["contact", "proton"]
        ];
        const count = window.innerWidth < 760 ? 2600 : 7200;
        const positions = new Float32Array(count * 3);
        const colors = new Float32Array(count * 3);
        const sizes = new Float32Array(count);
        const alphas = new Float32Array(count);
        const seeds = new Float32Array(count);
        const particles = [];
        const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, power: 0 };
        let width = window.innerWidth;
        let height = window.innerHeight;
        let viewW = 0;
        let viewH = 0;
        let breathe = 0;
        let scrollEnergy = 0;
        let lastScrollY = window.scrollY || 0;
        let scrollTargetProgress = 0;
        let scrollProgress = 0;
        let scrollTicking = false;

        function seededNoise(index, salt = 0) {
          const value = Math.sin(index * 127.1 + salt * 311.7) * 43758.5453123;
          return value - Math.floor(value);
        }

        function clamp(value, min, max) {
          return Math.min(max, Math.max(min, value));
        }

        function smoothstep(value) {
          const t = clamp(value, 0, 1);
          return t * t * (3 - 2 * t);
        }

        function lerp(from, to, progress) {
          return from + (to - from) * progress;
        }

        function updateViewSize() {
          width = window.innerWidth;
          height = window.innerHeight;
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          renderer.setSize(width, height, false);
          const distance = camera.position.z;
          viewH = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov * 0.5)) * distance;
          viewW = viewH * camera.aspect;
        }

        function targetFor(index, state) {
          const r = seededNoise(index, 2);
          const q = seededNoise(index, 3);
          const a = seededNoise(index, 4) * Math.PI * 2;
          const b = Math.acos(2 * seededNoise(index, 5) - 1);
          const role = seededNoise(index, 6);
          const scale = Math.min(viewW, viewH) / 860;
          const cx = 0;
          const cy = state === "planet" ? viewH * 0.06 : 0;
          const foreground = role > 0.94;

          if (role < 0.14) {
            const bokeh = role < 0.028;
            const bottomBias = seededNoise(index, 41);
            return {
              x: (seededNoise(index, 37) - 0.5) * viewW * 1.42,
              y: bokeh
                ? viewH * (bottomBias > 0.38 ? -0.28 + seededNoise(index, 42) * 0.18 : 0.06 + seededNoise(index, 43) * 0.38)
                : (seededNoise(index, 39) - 0.5) * viewH * 1.04,
              z: bokeh ? 520 + seededNoise(index, 40) * 560 : -900 + seededNoise(index, 40) * 1780,
              size: bokeh ? 1.35 + q * 3.4 : 0.18 + q * 0.58,
              alpha: bokeh ? 0.045 + q * 0.07 : 0.026 + q * 0.065,
              warm: bokeh ? 0.84 + q * 0.12 : 0.58 + q * 0.22
            };
          }

          if (foreground && state !== "planet" && state !== "proton" && state !== "atom") {
            const side = seededNoise(index, 26) > 0.5 ? 1 : -1;
            return {
              x: side * viewW * (0.22 + seededNoise(index, 27) * 0.38),
              y: (seededNoise(index, 28) - 0.45) * viewH * 0.92,
              z: 460 + seededNoise(index, 29) * 520,
              size: 0.7 + q * 1.6,
              alpha: 0.1 + q * 0.14,
              warm: 0.74 + q * 0.18
            };
          }

          if (state === "planet") {
            if (role < 0.76) {
              const surface = Math.pow(seededNoise(index, 44), 0.22);
              const radius = (92 + surface * 128 + q * 18) * scale;
              const flatten = 0.9 + seededNoise(index, 33) * 0.06;
              const rimBoost = Math.pow(Math.sin(b), 2.6);
              return {
                x: cx + Math.sin(b) * Math.cos(a) * radius,
                y: cy + Math.sin(b) * Math.sin(a) * radius * flatten,
                z: Math.cos(b) * radius * 1.22,
                size: 0.28 + q * 0.82 + rimBoost * 0.28,
                alpha: 0.11 + q * 0.22 + rimBoost * 0.24,
                warm: 0.72 + q * 0.2
              };
            }

            if (role < 0.992) {
              const ringIndex = index % 5;
              const ring = (232 + ringIndex * 48 + q * 36) * scale;
              const tilt = [0.18, 0.28, -0.22, -0.36, 0.44][ringIndex];
              const band = (seededNoise(index, 45) - 0.5) * (10 + ringIndex * 3) * scale;
              const wave = Math.sin(a * (1.4 + ringIndex * 0.18)) * (8 + ringIndex * 3) * scale;
              return {
                x: cx + Math.cos(a) * (ring + band),
                y: cy + Math.sin(a) * (ring + band) * (0.12 + ringIndex * 0.025) + wave * tilt,
                z: Math.sin(a) * ring * (0.22 + ringIndex * 0.026) + (seededNoise(index, 36) - 0.5) * 70 * scale,
                size: 0.22 + q * 0.62,
                alpha: 0.06 + q * 0.15,
                warm: 0.7 + q * 0.18
              };
            }

            return {
              x: (seededNoise(index, 19) - 0.5) * viewW * 0.92,
              y: cy + (seededNoise(index, 30) - 0.5) * viewH * 0.66,
              z: 360 + seededNoise(index, 31) * 500,
              size: 0.7 + q * 1.8,
              alpha: 0.08 + q * 0.14,
              warm: 0.74 + q * 0.2
            };
          }

          if (state === "shell") {
            if (role < 0.82) {
              const radius = (265 + q * 150) * scale;
              return {
                x: cx + Math.sin(b) * Math.cos(a) * radius,
                y: viewH * 0.02 + Math.sin(b) * Math.sin(a) * radius * 0.82,
                z: Math.cos(b) * radius * 1.06,
                size: 0.44 + q * 1.35,
                alpha: 0.12 + q * 0.24,
                warm: 0.62 + q * 0.18
              };
            }

            const ringIndex = index % 5;
            const ring = (352 + ringIndex * 46 + q * 38) * scale;
            return {
              x: cx + Math.cos(a) * ring,
              y: viewH * 0.02 + Math.sin(a) * ring * (0.12 + ringIndex * 0.03),
              z: Math.sin(a) * ring * (0.2 + ringIndex * 0.03),
              size: 0.3 + q * 0.78,
              alpha: 0.07 + q * 0.15,
              warm: 0.6 + q * 0.2
            };
          }

          if (state === "atom") {
            const orbit = index % 5;
            const nucleus = index % 8 === 0;
            const radius = nucleus ? q * 58 * scale : (100 + orbit * 42 + q * 24) * scale;
            return {
              x: Math.cos(a + orbit * 0.68) * radius,
              y: Math.sin(a + orbit * 0.68) * radius * (orbit % 2 ? 0.34 : 0.58),
              z: nucleus ? (q - 0.5) * 92 * scale : Math.sin(a * 1.7) * 92 * scale,
              size: nucleus ? 1.4 + q * 3.2 : 0.5 + q * 1.8,
              alpha: nucleus ? 0.22 + q * 0.34 : 0.1 + q * 0.22,
              warm: 0.62
            };
          }

          if (state === "scatter") {
            return {
              x: (seededNoise(index, 12) - 0.5) * viewW * 1.36,
              y: (seededNoise(index, 13) - 0.5) * viewH * 1.06,
              z: -860 + seededNoise(index, 14) * 1280,
              size: 0.45 + q * 2.4,
              alpha: 0.08 + q * 0.22,
              warm: 0.52
            };
          }

          const radius = (18 + Math.pow(q, 2) * 82) * scale;
          return {
            x: Math.cos(a) * radius,
            y: Math.sin(a) * radius,
            z: (seededNoise(index, 15) - 0.5) * 70 * scale,
            size: 0.8 + q * 2.8,
            alpha: 0.14 + q * 0.3,
            warm: 0.58
          };
        }

        function buildTargets(index) {
          return stateOrder.reduce((set, [, state]) => {
            set[state] = targetFor(index, state);
            return set;
          }, {});
        }

        function getScrollProgress() {
          const anchors = stateOrder
            .map(([id, state]) => {
              const section = document.getElementById(id);
