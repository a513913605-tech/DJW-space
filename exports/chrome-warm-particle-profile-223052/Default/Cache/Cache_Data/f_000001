        function getScrollSegment() {
          const anchors = stateOrder
            .map(([id, state]) => {
              const section = document.getElementById(id);
              return section ? { id, state, top: section.offsetTop } : null;
            })
            .filter(Boolean);

          if (!anchors.length) {
            return { from: "planet", to: "planet", progress: 0 };
          }

          const scrollY = window.scrollY || window.pageYOffset || 0;
          for (let i = 0; i < anchors.length - 1; i += 1) {
            const current = anchors[i];
            const next = anchors[i + 1];
            const distance = Math.max(next.top - current.top, 1);
            if (scrollY >= current.top && scrollY <= next.top) {
