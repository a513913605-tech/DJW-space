          }

          if (state === "shell") {
            const radius = stageRadius * (0.2 + ring * 0.31);
            const shellOffset = Math.sin(angle * 2.6 + ring * 4) * 46;
            return {
              x: centerX + Math.cos(angle) * (radius + shellOffset),
              y: centerY + Math.sin(angle) * (radius * 0.72 + shellOffset),
              z,
              size: isBokeh ? 4 + random * 9 : isFacet ? 2.4 + random * 5.6 : 0.6 + random * 1.7,
              alpha: isBokeh ? 0.04 + random * 0.08 : 0.15 + random * 0.32,
              layer: isBokeh ? "bokeh" : isFacet ? "facet" : "structure"
