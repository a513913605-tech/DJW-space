          fragmentShader: `
            varying float vAlpha;
            varying float vDepth;
            varying float vSeed;
            varying vec3 vColor;
            uniform float uTime;
            void main() {
              vec2 p = gl_PointCoord * 2.0 - 1.0;
              float d = length(p);
              float core = 1.0 - smoothstep(0.02, 0.34, d);
              float halo = 1.0 - smoothstep(0.18, 1.0, d);
              float sparkle = 0.82 + 0.18 * sin(uTime * 1.4 + vSeed * 31.0);
              float iris = 0.5 + 0.5 * sin(uTime * 0.42 + vSeed * 17.0 + p.x * 2.2);
              vec3 champagne = vec3(1.0, 0.82, 0.45);
              vec3 warmWhite = vec3(1.0, 0.96, 0.84);
              vec3 paleGold = vec3(0.92, 0.68, 0.32);
